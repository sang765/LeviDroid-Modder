<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/person_avatar"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:contentDescription="@string/xbox_avatar"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/person_gamertag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/person_presence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/misans"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/person_add"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minHeight="0dp"
        android:minWidth="64dp"
        android:backgroundTint="@color/primary"
        android:fontFamily="@font/misans"
        android:paddingHorizontal="10dp"
        android:text="@string/xbox_friends_add"
        android:textColor="@color/on_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:visibility="gone" />
</LinearLayout>
