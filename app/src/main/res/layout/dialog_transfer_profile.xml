<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/check_mods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/misans"
                android:text="@string/mods_section_title"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/check_worlds"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/misans"
                android:text="@string/worlds_category"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/check_resource_packs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/misans"
                android:text="@string/resource_packs_category"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/check_behavior_packs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/misans"
                android:text="@string/behavior_packs_category"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/check_skin_packs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/misans"
                android:text="@string/skin_packs_category"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/check_screenshots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:fontFamily="@font/misans"
                android:text="@string/screenshots_category"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/check_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="false"
                android:fontFamily="@font/misans"
                android:text="@string/transfer_settings"
                android:textColor="@color/on_surface"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_transfer_copy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/misans"
                    android:text="@string/transfer_copy"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_transfer_move"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/misans"
                    android:text="@string/transfer_move"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
