<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="horizontal"
    android:tag="levi_keep_background">

    <LinearLayout
        android:id="@+id/nav_bar_root"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:background="@color/ui_chrome"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/nav_back_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_back"
            android:padding="2dp"
            android:src="@drawable/ic_ui_arrow_back"
            android:tooltipText="@string/nav_back"
            app:tint="@color/ui_muted" />

        <ImageView
            android:id="@+id/nav_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_leaf_logo" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/nav_tab_launch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:contentDescription="@string/nav_launch"
            android:drawableStart="@drawable/ic_nav_launch"
            android:gravity="center"
            android:paddingStart="@dimen/levi_sidebar_icon_inset"
            android:paddingEnd="@dimen/levi_sidebar_icon_inset"
            android:tooltipText="@string/nav_launch" />

        <TextView
            android:id="@+id/nav_tab_download"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:contentDescription="@string/nav_download"
            android:drawableStart="@drawable/ic_nav_download"
            android:gravity="center"
            android:paddingStart="@dimen/levi_sidebar_icon_inset"
            android:paddingEnd="@dimen/levi_sidebar_icon_inset"
            android:tooltipText="@string/nav_download" />

        <TextView
            android:id="@+id/nav_tab_instances"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:contentDescription="@string/nav_instances"
            android:drawableStart="@drawable/ic_nav_instances"
            android:gravity="center"
            android:paddingStart="@dimen/levi_sidebar_icon_inset"
            android:paddingEnd="@dimen/levi_sidebar_icon_inset"
            android:tooltipText="@string/nav_instances" />

        <TextView
            android:id="@+id/nav_tab_about"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:contentDescription="@string/nav_about"
            android:drawableStart="@drawable/ic_nav_about"
            android:gravity="center"
            android:paddingStart="@dimen/levi_sidebar_icon_inset"
            android:paddingEnd="@dimen/levi_sidebar_icon_inset"
            android:tooltipText="@string/nav_about" />

        <TextView
            android:id="@+id/nav_tab_settings"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:contentDescription="@string/nav_settings"
            android:drawableStart="@drawable/ic_nav_settings"
            android:gravity="center"
            android:paddingStart="@dimen/levi_sidebar_icon_inset"
            android:paddingEnd="@dimen/levi_sidebar_icon_inset"
            android:tooltipText="@string/nav_settings" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include layout="@layout/shell_account_cluster" />

        <ImageView
            android:id="@+id/nav_theme_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/nav_toggle_theme"
            android:padding="6dp"
            android:src="@drawable/ic_sun"
            android:tooltipText="@string/nav_toggle_theme"
            app:tint="@color/ui_muted" />
    </LinearLayout>

    <View
        android:id="@+id/nav_divider"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/divider" />

    <FrameLayout
        android:id="@+id/shell_content"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:descendantFocusability="beforeDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true" />
</LinearLayout>
