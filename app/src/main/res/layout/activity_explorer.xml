<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/explorer_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/explorer_title"
                android:textAppearance="@style/TextAppearance.Levi.PageTitle"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/explorer_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/explorer_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/explorer_instance_button"
            style="@style/Widget.Levi.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="12dp"
            android:text="@string/explorer_select_instance"
            android:textSize="12sp"
            app:icon="@drawable/ic_nav_instances"
            app:iconSize="17dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/explorer_up_button"
            style="@style/Widget.Levi.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/explorer_up"
            android:tooltipText="@string/explorer_up"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/explorer_new_folder_button"
            style="@style/Widget.Levi.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/explorer_new_folder"
            android:tooltipText="@string/explorer_new_folder"
            app:icon="@drawable/ic_add"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/explorer_refresh_button"
            style="@style/Widget.Levi.Button.Icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/explorer_refresh"
            android:tooltipText="@string/explorer_refresh"
            app:icon="@drawable/ic_news_refresh"
            app:iconSize="18dp" />

        <TextView
            android:id="@+id/explorer_path"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="start"
            android:fontFamily="@font/misans"
            android:singleLine="true"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/explorer_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="4dp" />

        <ProgressBar
            android:id="@+id/explorer_loading_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/explorer_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/explorer_empty"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
